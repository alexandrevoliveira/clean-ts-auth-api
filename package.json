{
  "name": "clean-ts-auth-api",
  "version": "0.0.0",
  "description": "Professional API using Clean Architecture and TDD.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "clean architecture",
    "clean code",
    "tdd",
    "ddd",
    "solid",
    "design patterns",
    "node",
    "typescript",
    "jest",
    "typeorm"
  ],
  "author": {
    "name": "Alexandre Oliveira",
    "email": "alexandrevoliveira30@gmail.com",
    "url": "https://www.linkedin.com/in/alexandrevoliveira/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrevoliveira/clean-ts-auth-api.git"
  },
  "bugs": {
    "url": "https://github.com/alexandrevoliveira/clean-ts-auth-api/issues",
    "email": "alexandrevoliveira30@gmail.com"
  },
  "scripts": {
    "start": "node -r dotenv/config dist/main/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --clear -r dotenv/config --inspect=0.0.0.0:9229 src/main/server.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig-build.json",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/main/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/main/config/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/main/config/data-source.js",
    "prepare": "husky",
    "check": "npm-check -s -u",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --passWithNoTests --no-cache --runInBand",
    "test:watch": "npm t -- --watch",
    "test:staged": "npm t -- --findRelatedTests",
    "test:coverage": "npm t -- --coverage",
    "test:integration": "npm t -- --config ./jest.integration.config.js",
    "test:s3": "npm run test:integration -- ./tests/external/aws-s3-file-storage.test.ts"
  },
  "dependencies": {
    "aws-sdk": "^2.1252.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@jest-mock/express": "^3.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "git-commit-msg-linter": "^5.0.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^17.3.0",
    "mockdate": "^3.0.5",
    "neostandard": "^0.13.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
